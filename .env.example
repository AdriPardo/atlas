ATLAS_DB_URL=jdbc:postgresql://postgres:5432/atlas
ATLAS_DB_USERNAME=atlas
ATLAS_DB_PASSWORD=atlas
ATLAS_JWT_SECRET=change-me-change-me-change-me-change-me-32chars
ATLAS_JWT_EXPIRATION=86400
ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
ATLAS_ADMIN_USERNAME=admin
ATLAS_ADMIN_PASSWORD=ChangeMe123!
# Trust Authentik ForwardAuth headers (X-authentik-*). Default true on docker profile.
ATLAS_AUTHENTIK_ENABLED=false
# Group name substring → ADMIN; everyone else → OPERATOR
ATLAS_AUTHENTIK_ADMIN_GROUP=Atlas Admins
SPRING_PROFILES_ACTIVE=docker
