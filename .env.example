ATLAS_DB_URL=jdbc:postgresql://postgres:5432/atlas
ATLAS_DB_USERNAME=atlas
ATLAS_DB_PASSWORD=atlas
ATLAS_JWT_SECRET=change-me-change-me-change-me-change-me-32chars
ATLAS_JWT_EXPIRATION=86400
ATLAS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
ATLAS_ADMIN_USERNAME=admin
ATLAS_ADMIN_PASSWORD=ChangeMe123!
# Trust Authentik ForwardAuth headers (X-authentik-*). Default true on docker profile.
ATLAS_AUTHENTIK_ENABLED=false
# Group name substring → ADMIN; everyone else → OPERATOR
ATLAS_AUTHENTIK_ADMIN_GROUP=Atlas Admins
SPRING_PROFILES_ACTIVE=docker

# AES master key for secrets at rest (SSH keys, optional git.token). Use a long random string in prod.
ATLAS_SECRETS_MASTER_KEY=change-me-atlas-secrets-master-key-32

# Worker runs inside the API process by default (MVP). Set false on API-only replicas; true on worker replicas.
ATLAS_WORKER_ENABLED=true
ATLAS_WORKER_POLL_INTERVAL_MS=2000
ATLAS_WORKER_BATCH_SIZE=5
ATLAS_WORKER_ID=atlas-worker

# Git clone / compose working directories
ATLAS_WORKSPACE_DIR=/var/lib/atlas/workspaces

# Optional Docker engine for LOCAL hosts (empty = default socket / env)
# ATLAS_DOCKER_HOST=unix:///var/run/docker.sock

# Real Git/SSH/Docker adapters (false → Unsupported* stubs)
ATLAS_ADAPTERS_REAL_ENABLED=true
