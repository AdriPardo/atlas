      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum( rate(node_network_receive_bytes_total{ device!~\"lo|veth.*|br-.*|docker.*\" }[5m]) ) + sum( rate(node_network_transmit_bytes_total{ device!~\"lo|veth.*|br-.*|docker.*\" }[5m]) )",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
