      "title": "Network Throughput",
      "description": "Sum of receive+transmit bytes/sec on non-virtual interfaces (excludes lo/veth/br/docker).",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 7
