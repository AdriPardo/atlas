      "title": "Services UP",
      "description": "Instant counts: query A = `count(up == 1)` (UP), query B = `count(up)` (TOTAL). Display shows both series (e.g. 8 and 8).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "UP"
        },
        {
          "expr": "count(up)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "TOTAL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      }
