# Example production Compose for the Atlas VM (/opt/atlas/atlas).
# Copy to docker-compose.prod.yml on the host (gitignored) and adjust.
# Uses shared infra Postgres on atlas-internal (hostname: postgres).
# Does NOT start a local Postgres — that lives under /opt/atlas/infrastructure.
# Local/dev: use docker-compose.yml instead.

services:
  # ADR-0018: own Postfix MTA on atlas-internal (no Mailpit in prod).
  smtp:
    image: boky/postfix:latest
    restart: unless-stopped
    environment:
      ALLOWED_SENDER_DOMAINS: ${ATLAS_APP_SMTP_FROM_DOMAIN:-mail.example.com}
      HOSTNAME: smtp.${ATLAS_APP_SMTP_FROM_DOMAIN:-mail.example.com}
      RELAYHOST: ${ATLAS_SMTP_RELAYHOST:-}
      POSTFIX_inet_protocols: ipv4
      DKIM_AUTOGENERATE: "true"
      DKIM_SELECTOR: "default"
    ports:
      - "${ATLAS_SMTP_HOST_PORT:-2525}:25"
    volumes:
      - smtp_opendkim_keys:/etc/opendkim/keys
      # boky/postfix runs OpenDKIM via supervisord; patch init.d so health checks pass.
      - ./docker/smtp/10-opendkim-supervisord.sh:/docker-entrypoint-init.d/10-opendkim-supervisord.sh:ro
    networks:
      - internal

  backend:
    build:
      context: .
      dockerfile: docker/Dockerfile.backend
    restart: unless-stopped
    env_file:
      - .env
    environment:
      SPRING_PROFILES_ACTIVE: docker
      ATLAS_WORKER_ENABLED: ${ATLAS_WORKER_ENABLED:-true}
      ATLAS_WORKSPACE_DIR: /var/lib/atlas/workspaces
      ATLAS_BACKUP_DIR: /var/lib/atlas/backups
      # ADR-0015: set in .env — dedicated apps DB (never jdbc .../atlas). Role needs CREATEROLE.
      # ATLAS_APP_DB_URL=jdbc:postgresql://postgres:5432/apps
      # ATLAS_APP_DB_USERNAME=atlas
      # ATLAS_APP_DB_PASSWORD=...
      # ADR-0018: own Postfix (or point ATLAS_APP_SMTP_HOST at external MTA).
      # ATLAS_APP_SMTP_HOST=smtp
      # ATLAS_APP_SMTP_PORT=25
      # ATLAS_APP_SMTP_FROM_DOMAIN=mail.example.com
      # ATLAS_APP_SMTP_AUTO_INJECT=true
      # ATLAS_SMTP_RELAYHOST=   # empty = direct MX; or smtp.sendgrid.net:587
      # ATLAS_APP_SMTP_APP_HOST=  # blank = same as HOST; set if apps cannot resolve docker DNS
    ports:
      - "8080:8080"
    # LOCAL host sync/deploy needs the Docker socket. Backend user must share the host
    # docker group GID (default 988 on Debian/Ubuntu). SECURITY: socket access = full
    # control of the host engine — only for trusted single-tenant installs.
    group_add:
      - ${DOCKER_GID:-988}
    volumes:
      - atlas_workspaces:/var/lib/atlas/workspaces
      - atlas_backups:/var/lib/atlas/backups
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    depends_on:
      smtp:
        condition: service_started
    networks:
      - internal

  frontend:
    build:
      context: .
      dockerfile: docker/Dockerfile.frontend
    restart: unless-stopped
    ports:
      # Loopback only: public traffic must go through Traefik + Authentik (atlas.atlasops.dev).
      # Binding 0.0.0.0 would expose the SPA/login without SSO on the LAN.
      - "127.0.0.1:3000:80"
    depends_on:
      backend:
        # Prefer service_started so slow backend boot / Flyway does not abort compose up.
        # scripts/deploy.sh still waits for /actuator/health UP.
        condition: service_started
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=atlas-public"
      # UI + API behind Authentik ForwardAuth (middleware defined on Traefik infra).
      # Ensure Traefik forwards identity headers AND client Authorization to upstream, e.g.:
      # traefik.http.middlewares.authentik.forwardauth.authResponseHeaders=X-authentik-username,X-authentik-groups,X-authentik-email,X-authentik-name,X-authentik-uid
      - "traefik.http.routers.atlas.rule=Host(`atlas.atlasops.dev`)"
      - "traefik.http.routers.atlas.entrypoints=websecure"
      - "traefik.http.routers.atlas.tls=true"
      - "traefik.http.routers.atlas.tls.certresolver=cloudflare"
      - "traefik.http.routers.atlas.middlewares=authentik,securityHeaders@file,gzip@file"
      - "traefik.http.routers.atlas.priority=1"
      # SSO mint: GET /api/v1/auth/sso with ForwardAuth (browser document navigation).
      - "traefik.http.routers.atlas-sso.rule=Host(`atlas.atlasops.dev`) && PathPrefix(`/api/v1/auth/sso`)"
      - "traefik.http.routers.atlas-sso.entrypoints=websecure"
      - "traefik.http.routers.atlas-sso.tls=true"
      - "traefik.http.routers.atlas-sso.tls.certresolver=cloudflare"
      - "traefik.http.routers.atlas-sso.middlewares=authentik,securityHeaders@file,gzip@file"
      - "traefik.http.routers.atlas-sso.service=atlas"
      - "traefik.http.routers.atlas-sso.priority=95"
      # API XHR: Bearer JWT — no ForwardAuth (avoids 302 loops on fetch).
      - "traefik.http.routers.atlas-api.rule=Host(`atlas.atlasops.dev`) && PathPrefix(`/api/`)"
      - "traefik.http.routers.atlas-api.entrypoints=websecure"
      - "traefik.http.routers.atlas-api.tls=true"
      - "traefik.http.routers.atlas-api.tls.certresolver=cloudflare"
      - "traefik.http.routers.atlas-api.middlewares=securityHeaders@file,gzip@file"
      - "traefik.http.routers.atlas-api.service=atlas"
      - "traefik.http.routers.atlas-api.priority=90"
      # GitHub/GitLab webhooks must NOT hit Authentik (302 → Invalid HTTP Response).
      # Token-auth lives in Atlas API (permitAll + webhook secret). Priority > atlas.
      - "traefik.http.routers.atlas-webhooks.rule=Host(`atlas.atlasops.dev`) && PathPrefix(`/api/v1/webhooks/`)"
      - "traefik.http.routers.atlas-webhooks.entrypoints=websecure"
      - "traefik.http.routers.atlas-webhooks.tls=true"
      - "traefik.http.routers.atlas-webhooks.tls.certresolver=cloudflare"
      - "traefik.http.routers.atlas-webhooks.middlewares=securityHeaders@file,gzip@file"
      - "traefik.http.routers.atlas-webhooks.service=atlas"
      - "traefik.http.routers.atlas-webhooks.priority=100"
      - "traefik.http.services.atlas.loadbalancer.server.port=80"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    networks:
      - public
      - internal

volumes:
  atlas_workspaces:
  atlas_backups:
  smtp_opendkim_keys:

networks:
  public:
    external: true
    name: atlas-public
  internal:
    external: true
    name: atlas-internal
