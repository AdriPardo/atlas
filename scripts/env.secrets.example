# Copy to repo root as `.env.secrets` (gitignored) or export on the VM.
# Never commit real values. Optional bulk seed: ./scripts/seed-project-secrets.sh
#
# Atlas login (or set ATLAS_TOKEN):
# ATLAS_ADMIN_USERNAME=admin
# ATLAS_ADMIN_PASSWORD=
# ATLAS_API_BASE=http://127.0.0.1:8080
# ATLAS_SECRET_SCOPE=org
# ATLAS_PROJECT_ID=   # only if ATLAS_SECRET_SCOPE=project

# Known mappings (env var → Atlas logical name). Leave blank to skip.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://llm:11434/v1
ELEVENLABS_API_KEY=
DEEPSEEK_API_KEY=
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=
# GIT_TOKEN=
# CLOUDFLARE_API_TOKEN=
# DB_URL=
# STRIPE_SECRET_KEY=

# Extra free-form secrets (any name → same logical name in Atlas):
# ATLAS_EXTRA_SECRETS=pexels.api_key,my.app.token
# PEXELS_API_KEY=   # if using ATLAS_EXTRA with SCREAMING_SNAKE env matching

# Optional Reelpath PlatformSecret bridge (migration only):
# REELPATH_SEED_PLATFORM=1
# REELPATH_API_CONTAINER=reelpath-api-1
# PEXELS_API_KEY=
